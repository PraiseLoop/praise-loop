# --- Postgres (Compose service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=effective_memory

# --- Database URL ---
# Used by host execution (web/worker on the host, database in containers):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/effective_memory
# Compose services (migrate/web/worker) build their own URL from POSTGRES_*
# and connect via the service name (e.g. ...@postgres:5432/...) — this
# variable does not need to change for all-container runs.

# --- Redis ---
# Durable BullMQ generation delivery; localhost:6379 for host execution.
REDIS_URL=redis://localhost:6379

# --- AI (optional) ---
# Enables caption generation and the draft pipeline. When unset, caption
# generation fails with an actionable per-draft error (drafts are marked
# `failed`) instead of crashing the worker.
OPENAI_API_KEY=

# Alternative to OpenAI: OpenRouter. Used only when OPENAI_API_KEY is unset.
# OPENROUTER_MODEL is required and has no default; pick a model id at
# https://openrouter.ai/models (ids ending in :free cost nothing but are rate
# limited, and some providers log prompts, which include reviewer quotes).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Milliseconds before the caption provider call is aborted (default: 20000).
OPENAI_TIMEOUT_MS=20000

# --- Worker ---
# Milliseconds between draft-generation sweeps (default: 60000).
DRAFT_PIPELINE_INTERVAL_MS=60000

# --- Generated media ---
# Where rendered draft images are written and served from. Defaults to
# private-media (the generated_media volume mount point in Compose).
MEDIA_ROOT=

# --- Pilot hosting (docker-compose.pilot.yml; docs/development.md#pilot-hosting) ---
# Set on the server only. Never commit the real token.
CLOUDFLARE_TUNNEL_TOKEN=

# Owner sign-in: Google OAuth web client (openid/email/profile only); see docs/auth.md.
# On the pilot server set NEXTAUTH_URL to the tunnel hostname (https://praise.example.com).
# The phone app's production API_BASE_URL (#84) is the same URL.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_GENERATION_DAILY_LIMIT=25

# --- Pilot self-service plan upgrades ---
# Comma-separated verified owner emails. A listed owner sees an "Upgrade to Pro"
# button on /account and may change their own plan. Empty (or unset) allows
# nobody, so plans stay operator-only (docs/features.md has the operator commands).
# For testing only: it unlocks Pro with no payment, so leave it empty once billing is live.
SELF_SERVICE_UPGRADE_EMAILS=

# --- Mobile app gate (public, owner-free) ---
# Installed apps below MOBILE_MINIMUM_VERSION show an "update required" screen.
# Features is a comma-separated list of flag names; minimum defaults to 1.0.0, latest to the minimum, features to none.
MOBILE_MINIMUM_VERSION=1.0.0
MOBILE_LATEST_VERSION=
MOBILE_FEATURES=

# Native Google Sign-In for the mobile app (#81): OAuth client IDs of the iOS and Android
# clients; ID tokens are accepted only if their audience is one of these. See docs/auth.md.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Sign in with Apple for the mobile app (#92): comma-separated audiences accepted
# from Apple identity tokens. The native app's bundle id is ca.visda.praiseloop;
# add the Services ID only when web Apple sign-in exists. Empty fails closed.
APPLE_CLIENT_ID=

# Sign in with Microsoft (Entra ID, #158). MICROSOFT_CLIENT_ID is the app
# registration's application (client) id and also the comma-separated audience
# list the phone's ID tokens must match. With several ids, the FIRST one is the
# web app registration (the web flow uses exactly one application). MICROSOFT_CLIENT_SECRET is used by the
# web NextAuth provider only. Empty hides the web button and fails the phone
# exchange closed. See docs/auth.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Buffer OAuth connect (#29; docs/integrations.md) ---
# Confidential Buffer app client. Missing any of these (or a redirect base) makes
# POST /api/buffer/connect answer 503 and the callback report not_configured.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Optional override; defaults to ${NEXTAUTH_URL}/api/buffer/callback.
BUFFER_REDIRECT_URI=
# 32 random bytes, base64; encrypts Buffer tokens and the PKCE verifier at rest.
CREDENTIAL_ENCRYPTION_KEY=

# --- Posting through Buffer (#29) ---
# The safety gate. off (default): nothing is ever sent to Buffer. draft: the worker sends due posts to
# Buffer as DRAFTS (nothing is published). live: the worker publishes. Needs NEXTAUTH_URL to be an
# https address Buffer can reach, and the /api/public-media/ path open to the internet.
BUFFER_POSTING_MODE=off

# --- Google reviews through Apify (#232, removable stopgap) ---
# Leave APIFY_TOKEN blank to hide the feature; it fails closed when unset. The token
# is read from the environment and sent only as a Bearer header, never in a URL.
# These rows use source apify_google and are separate from official sync (#46).
# See docs/integrations.md for the accepted scraping/terms risk.
APIFY_TOKEN=
# Reviews requested per run by plan. Missing or invalid values use these defaults.
APIFY_REVIEW_LIMIT_FREE=5
APIFY_REVIEW_LIMIT_PRO=10
APIFY_REVIEW_LIMIT_BUSINESS=15
# One run per business per interval, on every plan (default 24).
APIFY_REVIEW_RUN_INTERVAL_HOURS=24
# Apify run spend cap in USD (default 0.50).
APIFY_MAX_CHARGE_USD=0.50

# --- Logging (docs/development.md, "Logging") ---
# prod (default): quiet; warnings, errors and notable activity. dev: verbose; every API request, every
# posting decision, every failed step with its cause. LOG_LEVEL (debug, info, warn, error) overrides.
# Logs never contain credentials, tokens, captions, review text or emails in either mode.
APP_ENV=prod
LOG_LEVEL=

# --- Demo sign-in (development only) ---
# Enables POST /api/mobile/session/dev and `npm run dev:seed`, which sign in a fixed
# synthetic owner so the phone flow can be walked without Google OAuth. Ignored by a
# production build (NODE_ENV=production). Leave blank everywhere else.
MOBILE_DEV_AUTH=

# Dev stack only: the `mobile` service starts the Expo server for Expo Go (see
# docs/development.md). It finds this machine's LAN address itself; set DEV_LAN_IP to
# override (several networks, a VPN). MOBILE_PORT changes the Expo port (default 8081).
DEV_LAN_IP=
MOBILE_PORT=

# --- Push notifications (optional) ---
# Expo access token, only needed if enhanced push security is enabled.
EXPO_ACCESS_TOKEN=

# --- Phone app build settings (read by the Expo app when it starts; the dev compose stack passes them) ---
# Google web client id; empty uses GOOGLE_CLIENT_ID. iOS also needs the iOS client id and URL scheme.
# Native Google sign-in only appears in a development build, never in Expo Go (docs/development.md).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
# Microsoft app registration id for the phone (the web one is MICROSOFT_CLIENT_ID).
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
# Expo (EAS) project id, needed to get a push token.
EXPO_PUBLIC_EAS_PROJECT_ID=

# --- Transactional email (sign-in codes; docs/integrations.md) ---
# Leave blank for development and tests: outside production the fake transport
# records each message in memory and logs a single `email_outbox` line (with the
# code) instead of sending anything. In production both EMAIL_FROM and
# RESEND_API_KEY are required or email fails closed. EMAIL_FROM must be on a
# domain verified in Resend; EMAIL_TRANSPORT is `fake` or `resend`.
EMAIL_TRANSPORT=
EMAIL_FROM=
RESEND_API_KEY=
